@startuml
!pragma layout smetana
title UML - варианты использования
left to right direction
skinparam shadowing false

actor Клиент as client
actor Мастер as master
actor Оператор as operator
actor Администратор as admin

rectangle "MyService Platform" {
  usecase "Посмотреть каталог" as UC1
  usecase "Рассчитать цену" as UC2
  usecase "Создать заказ" as UC3
  usecase "Посмотреть заказ" as UC4
  usecase "Отменить заказ" as UC5
  usecase "Подтвердить заказ" as UC6
  usecase "Назначить мастера" as UC7
  usecase "Посмотреть расписание" as UC8
  usecase "Изменить статус работы" as UC9
  usecase "Управлять услугами" as UC10
  usecase "Управлять доступом" as UC11
}

client --> UC1
client --> UC2
client --> UC3
client --> UC4
client --> UC5
operator --> UC6
operator --> UC7
master --> UC8
master --> UC9
admin --> UC10
admin --> UC11
@enduml
